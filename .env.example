# SystemOne Gate: example environment file.
#
# SystemOne Gate does NOT read a .env file by itself; it only reads the process
# environment. Copy this file to `.env` (already in .gitignore) and load it into your
# shell before running the CLI, the git hook or the MCP server:
#
#   cp .env.example .env
#   set -a; . ./.env; set +a
#   systemone-gate doctor
#
# Every line below is commented out and shows the DEFAULT (or an example when there is
# none, as with SYSTEMONE_PROTECTED_PATHS). Uncomment only what you want to change. Never put real secrets in `.env.example`; it is committed.

# --- Ollama backend ---------------------------------------------------------------
# Endpoint of the /v1/systemone API (loopback only unless SYSTEMONE_ALLOW_REMOTE is set).
# OLLAMA_SYSTEMONE_URL=http://localhost:11434/v1/systemone
# Allow a non-loopback endpoint. Diffs and commands are sent there: leave off unless you trust it.
# SYSTEMONE_ALLOW_REMOTE=
# Seconds per call (positive number). The pre-commit hook defaults to 120 because of nimble's cold start.
# SYSTEMONE_TIMEOUT=30

# --- Diff review ------------------------------------------------------------------
# Model for `systemone-gate diff` and the hook (--model / --nimble take precedence).
# SYSTEMONE_DIFF_MODEL=nimble
# Rubric profile: default | generic | web-backend (the --profile argument takes precedence).
# SYSTEMONE_PROFILE=default
# A diff is blocked only when BOTH values are exceeded.
# SYSTEMONE_DIFF_RISK_THRESHOLD=1.85
# SYSTEMONE_DIFF_BREAKING_THRESHOLD=0.65

# --- Guard ------------------------------------------------------------------------
# Block when the danger score exceeds this value (0 to 2).
# SYSTEMONE_GUARD_DANGER_THRESHOLD=1.5
# No default. `:`-separated absolute paths (~ and $HOME allowed) that the guard must never let a command touch.
# SYSTEMONE_PROTECTED_PATHS=~/.ssh:~/.gnupg

# --- Failure policy ---------------------------------------------------------------
# What to do when the model is unreachable or returns an invalid answer: allow | block.
# SYSTEMONE_DIFF_ON_ERROR=allow
# SYSTEMONE_GUARD_ON_ERROR=allow
# Opt-in (0 to 1): treat a verdict below this confidence as indeterminate. 0 = off.
# SYSTEMONE_MIN_CONFIDENCE=0

# --- Output and privacy -----------------------------------------------------------
# Any non-empty value other than 0 = ASCII output instead of emoji.
# SYSTEMONE_PLAIN=
# Secret redaction before sending text to the model. 0 disables it (not recommended).
# SYSTEMONE_REDACT=1
# Any non-empty value other than 0 skips only the SystemOne Gate pre-commit check. Prefer
# passing it inline for one commit (SYSTEMONE_SKIP=1 git commit ...) instead of setting it here.
# SYSTEMONE_SKIP=
